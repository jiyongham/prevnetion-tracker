# JIRA (PAT/Bearer 인증)
JIRA_URL=https://your-jira-host
JIRA_PAT=your_personal_access_token
JIRA_PROJECT=your_project_key

# Confluence (EoS 차주 계획서 페이지 파싱용, PAT/Bearer 인증)
CONFLUENCE_URL=https://your-confluence-host
CONFLUENCE_PAT=your_personal_access_token
CONFLUENCE_EOS_PARENT_PAGE_ID=      # 주간 작업계획 페이지들의 부모 페이지 ID

# JIRA 커스텀필드 ID (사내 JIRA 스키마 - 관리자 화면이나 /rest/api/2/field 로 확인)
PLANNED_END_DATE_FIELD=customfield_xxxxx     # 변경 계획 완료일
PLANNED_START_DATE_FIELD=customfield_xxxxx   # 변경 계획 시작일
MATCH_FIELDS=customfield_xxxxx,customfield_xxxxx  # 변경작업 대상/완료보고 (호스트명·IP 포함, 콤마 구분)
JSM_REQUESTER_FIELD=customfield_xxxxx        # JSM요청자
DR_WORK_TYPE_FIELD=customfield_xxxxx         # 작업 구분 (DR훈련 판정 보조)
EOS_CMDB_DONE_FIELD=customfield_xxxxx        # 작업 완료(CMDB) - EoS 전환완료 판정

TEAMS_WEBHOOK=https://outlook.office.com/webhook/...
EXCEL_PATH=data/targets.xlsx
DASHBOARD_URL=http://your-dashboard-host:8000
SENDER_TEAM=담당팀명
SENDER_NAME=담당자명
CAPACITY_SENDER_NAME=용량관리_담당자명
EOS_SENDER_NAME=EoS_담당자명
ADMIN_USERS=DR훈련_관리자명
CAPACITY_ADMIN_USERS=용량관리_관리자명
EOS_ADMIN_USERS=EoS_관리자명

# OS 커널 패치 (보안 취약점 CVSS 8~9점대)
# 미지정 시 EOS_ADMIN_USERS 를 그대로 쓴다
KERNEL_ADMIN_USERS=
KERNEL_DEV_EXCEL_PATH=data/kernel_dev.xlsx
# 운영기 확대 후 파일이 준비되면 경로를 채운다 (비어 있으면 그 탭 자체가 안 나온다)
KERNEL_PROD_EXCEL_PATH=
# Polestar PQL 결과 내보내기(= 타겟 패치레벨에 걸린 서버 목록).
# 타겟 커널이 배포판별로 확정된 뒤에 채운다 - 그 전에 넣으면 '패치 완료'가 아니라
# '그 커널을 쓰는 배포판'이 통째로 완료로 잡힌다.
KERNEL_PATCHED_EXPORT_PATH=

# 조회 챗봇 (사내 LLM Agent 게이트웨이)
AGENT_TOKEN_URL=https://.../api/v1/auth/token
AGENT_GATEWAY_URL=https://...
AGENT_CLIENT_ID=your_client_id
AGENT_CLIENT_SECRET=your_client_secret
AGENT_ID=
AGENT_CODE=

# 진단 전용 에이전트 (매칭 미확인 사유 / 담당자 불일치 판단) - 별도 시스템 프롬프트로 새로 생성
DIAGNOSE_AGENT_ID=
DIAGNOSE_AGENT_CODE=

# 주간 리포트 "이번 주 특이사항" 요약 전용 에이전트 - 별도 시스템 프롬프트로 새로 생성
SUMMARY_AGENT_ID=
SUMMARY_AGENT_CODE=
